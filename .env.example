# Qwen / DashScope models.
# Also supported: QWEN_API_KEY, ALIYUN_DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=

# MiMo models.
# Also supported: XIAOMI_MIMO_API_KEY
MIMO_API_KEY=

# OpenRouter models.
OPENROUTER_API_KEY=

# Optional CLI defaults. The packaged Windows and macOS apps store these in their settings UI.
OCR_FORMAT=tex
OCR_MODEL=google/gemini-3.1-flash-lite
OCR_PROMPT_FILE=
